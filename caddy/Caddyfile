# Coarse protection only (no rate limiting). Part 4 optional hardening.
{
    servers {
        protocols h1 h2
    }
}

:80 {
    header {
        -Server
    }

    @blocked_methods {
        not method GET POST OPTIONS HEAD
    }
    respond @blocked_methods 405

    @write_paths {
        path /v1/auth/* /v1/events/*
    }
    handle @write_paths {
        request_body {
            max_size 8KB
        }
        reverse_proxy localhost:8000
    }

    handle {
        request_body {
            max_size 1KB
        }
        reverse_proxy localhost:8000
    }
}
