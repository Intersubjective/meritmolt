# Caddy: domain for HTTPS (required when using Caddy; use localhost for local dev)
CADDY_DOMAIN=

# Postgres (required for DB)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_USER=postgres
POSTGRES_PASSWORD=
POSTGRES_DB=postgres

# MoltBook: app key for verify-identity (required)
MM_MOLTBOOK_APP_KEY=
# MoltBook API base URL
MM_MOLTBOOK_API_BASE=https://www.moltbook.com/api/v1

# JWT: JSON object kid -> PEM string (required for auth)
# Example: MM_JWT_PRIVATE_KEYS='{"default":"-----BEGIN EC PRIVATE KEY-----\n...\n-----END EC PRIVATE KEY-----"}'
MM_JWT_PRIVATE_KEYS={}
MM_JWT_PUBLIC_KEYS={}

# TTLs (seconds)
MM_ACCESS_TTL_SECONDS=900
MM_REFRESH_TTL_SECONDS=2592000
MM_REFRESH_MAX_ACTIVE_PER_AGENT=5

# HTTP client for MoltBook
MM_HTTP_TIMEOUT_SECONDS=10.0
MM_HTTP_RETRY_MAX_ATTEMPTS=3

# Rate limiting (Part 4)
MM_RL_AUTH_LOGIN_LIMIT=30
MM_RL_AUTH_REFRESH_LIMIT=10
MM_RL_WRITES_BURST=20
MM_RL_WRITES_SUSTAIN=60
MM_RL_READS_BURST=60
MM_RL_READS_SUSTAIN=300
MM_RL_BUCKET_MAX_KEYS=10000
MM_RL_BUCKET_TTL_SECONDS=3600
# MM_RL_REDIS_URL=  # optional; set for multi-instance shared limits

# Backpressure
MM_BP_GLOBAL_MAX_CONCURRENT=100
MM_BP_READS_MAX_CONCURRENT=50
MM_BP_WRITES_MAX_CONCURRENT=30
MM_BP_AUTH_MAX_CONCURRENT=20
MM_BP_REQUEST_DEADLINE_SECONDS=10.0

# Moltbook Crawler (textlake DB)
MB_CRAWLER_API_KEY=
MB_API_BASE=https://www.moltbook.com/api/v1
MB_RATE_LIMIT_RPM=100
MB_CONCURRENCY=10
MB_HTTP_SEMAPHORE=10
# For crawler service set POSTGRES_DB=textlake (meritmolt uses postgres)
